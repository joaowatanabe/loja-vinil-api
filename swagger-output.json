    "/vendas/": {
      "get": {
        "tags": [
          "Vendas"
        ],
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Vendas"
        ],
        "summary": "Registra uma venda (transação)",
        "description": "Em uma única transação: (1) baixa o estoque do disco, (2) cria a venda com o preço congelado do momento e (3) soma o valor no totalGasto do cliente. Se qualquer passo falhar (cliente/disco inexistente, estoque insuficiente), é feito ROLLBACK e nada muda no banco.",
        "responses": {
          "201": {
            "description": "Venda registrada; retorna a venda, o disco com o estoque novo e o cliente com o total atualizado",
            "content": {
              "application/json": {
                "example": {
                  "venda": {
                    "id": 7,
                    "clienteId": 1,
                    "discoId": 2,
                    "quant": 1,
                    "preco": "289.9",
                    "data": "2026-10-23T22:10:00.000Z"
                  },
                  "disco": {
                    "id": 2,
                    "titulo": "Random Access Memories",
                    "estoque": 3
                  },
                  "cliente": {
                    "id": 1,
                    "nome": "Ana Souza",
                    "totalGasto": "579.8"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos (Zod) ou estoque insuficiente",
            "content": {
              "application/json": {
                "example": {
                  "erro": "Estoque insuficiente: há apenas 0 cópia(s) de Random Access Memories"
                }
              }
            }
          },
          "404": {
            "description": "Cliente ou disco não cadastrado",
            "content": {
              "application/json": {
                "example": {
                  "erro": "Disco não cadastrado"
                }
              }
            }
          },
          "409": {
            "description": "Conflict"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "clienteId",
                  "discoId",
                  "quant"
                ],
                "properties": {
                  "clienteId": {
                    "type": "integer",
                    "example": 1,
                    "description": "Código do cliente"
                  },
                  "discoId": {
                    "type": "integer",
                    "example": 2,
                    "description": "Código do disco"
                  },
                  "quant": {
                    "type": "integer",
                    "example": 1,
                    "minimum": 1,
                    "description": "Quantidade de cópias"
                  }
                }
              }
            }
          }
        }
      }
    },
