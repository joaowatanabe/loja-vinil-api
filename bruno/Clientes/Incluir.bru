meta {
  name: Incluir cliente
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/clientes
  body: json
  auth: none
}

body:json {
  {
    "nome": "Diego Alves {{sufixo}}",
    "email": "diego{{sufixo}}@email.com"
  }
}

script:pre-request {
  bru.setVar("sufixo", Date.now().toString().slice(-6));
}

script:post-response {
  bru.setVar("clienteId", res.body.id);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
