meta {
  name: Alterar disco
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/discos/{{discoId}}
  body: json
  auth: none
}

body:json {
  {
    "titulo": "Kind of Blue (remaster) {{sufixo}}",
    "artista": "Miles Davis",
    "ano": 1959,
    "preco": 259.9,
    "estoque": 5,
    "generoId": 1
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}
