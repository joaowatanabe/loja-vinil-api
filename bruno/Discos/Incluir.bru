meta {
  name: Incluir disco
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/discos
  body: json
  auth: none
}

body:json {
  {
    "titulo": "Kind of Blue {{sufixo}}",
    "artista": "Miles Davis",
    "ano": 1959,
    "preco": 229.9,
    "estoque": 3,
    "generoId": 1
  }
}

script:pre-request {
  bru.setVar("sufixo", Date.now().toString().slice(-6));
}

script:post-response {
  bru.setVar("discoId", res.body.id);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
