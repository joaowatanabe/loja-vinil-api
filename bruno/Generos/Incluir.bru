meta {
  name: Incluir gênero
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/generos
  body: json
  auth: none
}

body:json {
  {
    "nome": "Jazz {{sufixo}}"
  }
}

script:pre-request {
  bru.setVar("sufixo", Date.now().toString().slice(-6));
}

script:post-response {
  bru.setVar("generoId", res.body.id);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
